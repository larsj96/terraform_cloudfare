# Local .terraform directories
**/.terraform/*

# Terraform state and local secrets
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfbackend
!*.tfbackend.example
*.auto.tfvars

# Crash log files
crash.log
crash.*.log

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
